---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import IdentificationSection from '@/components/sections/IdentificationSection.astro';
import AboutSection from '@/components/sections/AboutSection.astro';
import DifferentialsSection from '@/components/sections/DifferentialsSection.astro';
import CarePrinciplesSection from '@/components/sections/CarePrinciplesSection.astro';
import TccSection from '@/components/sections/TccSection.astro';
import IntroVideoSection from '@/components/sections/IntroVideoSection.astro';
import ProcessSection from '@/components/sections/ProcessSection.astro';
import InstagramSection from '@/components/sections/InstagramSection.astro';
import EmotionalBreakSection from '@/components/sections/EmotionalBreakSection.astro';
import FaqSection from '@/components/sections/FaqSection.astro';
import FinalCtaSection from '@/components/sections/FinalCtaSection.astro';
---

<BaseLayout>
  <Header slot="header" />

  <HeroSection />
  <IdentificationSection />
  <AboutSection />
  <DifferentialsSection />
  <CarePrinciplesSection />
  <TccSection />
  <IntroVideoSection />
  <ProcessSection />
  <InstagramSection />
  <EmotionalBreakSection />
  <FaqSection />
  <FinalCtaSection />

  <Footer slot="footer" />
</BaseLayout>
