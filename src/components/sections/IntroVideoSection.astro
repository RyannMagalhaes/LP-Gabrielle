---
import { getImage } from 'astro:assets';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import OrganicShape from '@/components/ui/OrganicShape.astro';
// TODO: swap for a real frame grabbed from the final compressed video
// (ffmpeg -ss 00:00:0X -i intro.mp4 -frames:v 1 poster.jpg) once it exists -
// this is a real photo standing in, not the actual video's first frame.
import videoPosterSource from '@/assets/photos/video-poster.jpg';

const VIDEO_SRC = '/video/intro.mp4';
const videoPoster = await getImage({ src: videoPosterSource, width: 1400, format: 'jpg' });
---

<section class="py-20 md:py-32">
  <Container class="grid items-center gap-14 md:grid-cols-12 md:gap-8">
    <div class="relative order-2 md:order-1 md:col-span-7" data-reveal>
      <svg
        data-reveal
        data-reveal-delay="120"
        class="organic-line pointer-events-none absolute -left-3 -top-3 h-8 w-8 md:-left-4 md:-top-4 md:h-10 md:w-10"
        viewBox="0 0 56 56"
        aria-hidden="true"
      >
        <path
          pathLength="1"
          d="M2 28C2 13 13 2 28 2"
          stroke="var(--color-rose-deep)"
          stroke-width="2"
          fill="none"
          stroke-linecap="round"
        />
      </svg>

      <!-- Matte: encloses the video on every side (not just an offset corner)
           so no edge is left sitting bare on the canvas. Blush, the wash
           already used as a section/CTA background elsewhere, not a new
           solid color introduced just for this frame. -->
      <div class="rounded-image-lg bg-blush/70 p-3 md:p-4">
        <video
          controls
          preload="metadata"
          playsinline
          poster={videoPoster.src}
          class="aspect-[16/9] w-full rounded-image-sm bg-ink object-cover shadow-[0_20px_40px_-22px_rgba(52,48,47,0.55)]"
        >
          <source src={VIDEO_SRC} type="video/mp4" />
        </video>
      </div>

      <div
        class="pointer-events-none absolute -bottom-3 -right-3 h-12 w-12 overflow-hidden opacity-90 md:-bottom-4 md:-right-4 md:h-14 md:w-14"
        aria-hidden="true"
      >
        <OrganicShape variant="ink" widthPx={120} class="h-auto w-[120px] max-w-none rotate-[-14deg]" />
      </div>
    </div>

    <div class="order-1 flex flex-col justify-center md:order-2 md:col-span-5" data-reveal data-reveal-delay="100">
      <SectionHeading size="h2" class="max-w-[14ch]">
        Um pouco sobre como eu trabalho.
      </SectionHeading>

      <svg
        data-reveal
        data-reveal-delay="140"
        class="organic-line mt-8 h-4 w-16"
        viewBox="0 0 64 16"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          pathLength="1"
          d="M1 7C9 1 15 15 23 8S37 2 45 9 57 15 63 8"
          stroke="var(--color-rose-deep)"
          stroke-opacity="0.5"
          stroke-width="1.5"
          fill="none"
        />
      </svg>

      <p class="mt-5 max-w-[30ch] font-body text-[clamp(1.5rem,2.4vw,2.1rem)] italic leading-[1.3] text-ink">
        "Acredito que um bom processo terapêutico começa quando você encontra um espaço
        onde pode verdadeiramente ser você."
      </p>
    </div>
  </Container>
</section>
