---
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import MediaPlaceholder from '@/components/ui/MediaPlaceholder.astro';

// TODO: once the real video file exists, set VIDEO_SRC and the facade script
// below will swap the poster for a real <video controls preload="none"> on click.
const VIDEO_SRC = '';
---

<section class="py-20 md:py-32">
  <Container class="grid items-center gap-14 md:grid-cols-12 md:gap-8">
    <div class="order-2 md:order-1 md:col-span-7" data-reveal>
      <div id="video-slot" data-video-src={VIDEO_SRC} class="relative">
        <button
          type="button"
          id="video-play-trigger"
          class="group block w-full text-left"
          aria-label="Reproduzir vídeo de apresentação"
        >
          <MediaPlaceholder
            label="Vídeo: introdução (45–90s) — a substituir"
            aspectRatio="16/9"
            targetPath="src/assets/video/poster.jpg"
            variant="video"
            radiusClass="rounded-image-sm"
            class="transition-transform duration-[var(--dur-hover)] ease-[var(--ease-standard)] group-hover:scale-[1.01]"
          />
        </button>
      </div>
    </div>

    <div class="order-1 flex flex-col justify-center md:order-2 md:col-span-5" data-reveal data-reveal-delay="100">
      <Eyebrow>Conheça meu trabalho</Eyebrow>
      <SectionHeading size="h2" class="mt-5 max-w-[14ch]">
        Um pouco sobre como eu trabalho.
      </SectionHeading>
      <p class="mt-6 max-w-[46ch] font-body text-body-lg italic text-muted">
        "Acredito que um bom processo terapêutico começa quando você encontra um espaço
        onde pode verdadeiramente ser você."
      </p>
    </div>
  </Container>
</section>

<script>
  const slot = document.getElementById('video-slot');
  const trigger = document.getElementById('video-play-trigger');
  const src = slot?.dataset.videoSrc;

  trigger?.addEventListener('click', () => {
    if (!slot || !src) return; // no real video file yet - nothing to swap in
    slot.innerHTML = `<video controls autoplay playsinline preload="none" class="w-full rounded-[var(--radius-image-sm)]" src="${src}"></video>`;
  });
</script>
