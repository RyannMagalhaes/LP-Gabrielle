---
import { Image } from 'astro:assets';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import DecorativeAsset from '@/components/ui/DecorativeAsset.astro';
import { DIFFERENTIALS } from '@/data/differentials';
import differentialsPhoto from '@/assets/photos/differentials.jpg';
---

<section id="diferenciais" class="relative py-20 md:py-32">
  <!-- Right-edge accent, mirroring the left-edge one two sections up - the
       list's 46ch measure leaves the far right margin empty on wide screens.
       Rooted at the section's bottom edge rather than floating mid-air. -->
  <div
    class="pointer-events-none absolute bottom-0 right-2 hidden w-36 opacity-80 xl:block"
    aria-hidden="true"
    data-parallax="10"
  >
    <DecorativeAsset
      variant="tulip-open-beige"
      widthPx={500}
      class="h-auto w-full rotate-[7deg]"
    />
  </div>

  <Container class="grid gap-12 md:grid-cols-12 md:items-center md:gap-8">
    <div data-reveal class="md:order-1 md:col-span-5">
      <Image
        src={differentialsPhoto}
        alt="Gabrielle Favere apoiada lendo um livro de Terapia Cognitivo-Comportamental"
        width={640}
        loading="lazy"
        decoding="async"
        class="aspect-[3/4] w-full mask-organic-2 object-cover object-[50%_20%]"
      />
    </div>

    <div class="md:order-2 md:col-span-7">
      <SectionHeading data-reveal size="h2" class="max-w-[18ch]">
        Uma terapia construída para você.
      </SectionHeading>

      <div class="mt-10 divide-y divide-border/70">
        {
          DIFFERENTIALS.map((item, index) => (
            <div data-reveal data-reveal-delay={index * 90} class="py-6 first:pt-0">
              <h3 class="font-display text-h3 text-ink">{item.title}</h3>
              <p class="mt-2 max-w-[46ch] font-body text-body text-muted">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</section>
