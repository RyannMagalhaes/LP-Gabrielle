---
interface Props {
  class?: string;
  open?: boolean;
}
const { class: className = 'w-6 h-6' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <path
    class="menu-icon-top"
    d="M4 7h16"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
  />
  <path
    class="menu-icon-bottom"
    d="M4 17h16"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
  />
</svg>
