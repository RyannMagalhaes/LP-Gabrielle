---
// Linear replacement for the old cyclic triad diagram: Situação leads to
// Pensamentos, Sentimentos and Comportamento in sequence, reusing the site's
// own stacked-divider-list idiom (Identification/Differentials) rather than
// a new card grid. No connecting line here - Identification already owns
// that motif; repeating it made the two sections read as the same moment.
import { MessageCircle, Brain, Heart, Footprints } from '@lucide/astro';
import { COGNITIVE_MODEL_STAGES } from '@/data/cognitive-model';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const ICONS = { situacao: MessageCircle, pensamentos: Brain, sentimentos: Heart, comportamento: Footprints };
---

<div class:list={['flex flex-col divide-y divide-border/70', className]}>
  {
    COGNITIVE_MODEL_STAGES.map((stage, index) => {
      const Icon = ICONS[stage.key];
      return (
        <div
          data-reveal
          data-reveal-delay={index * 110}
          class:list={['relative flex gap-5 py-6 first:pt-0 last:pb-0']}
        >
          <span class="relative z-10 flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full border-2 border-rose-deep bg-surface-soft">
            <Icon width={20} height={20} color="var(--color-rose-deep)" stroke-width={1.8} aria-hidden="true" />
          </span>
          <div class="pt-1.5">
            <h3 class="font-display text-h3 text-ink">{stage.title}</h3>
            <p class="mt-1.5 max-w-[46ch] font-body text-body text-muted">{stage.description}</p>
          </div>
        </div>
      );
    })
  }
</div>
