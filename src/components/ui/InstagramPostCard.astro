---
import MediaPlaceholder from './MediaPlaceholder.astro';
import { buildInstagramProfileUrl, INSTAGRAM_HANDLE } from '@/lib/instagram.config';
import type { InstagramPost } from '@/data/instagram-posts';

interface Props {
  post: InstagramPost;
  index: number;
  total: number;
}

const { post, index, total } = Astro.props;
const href = post.postUrl ?? buildInstagramProfileUrl();

const ariaLabel = `Publicação ${index + 1} de ${total} no Instagram: "${post.caption}". Abrir perfil @${INSTAGRAM_HANDLE} no Instagram, nova aba.`;
---

<li class="flex-none snap-start instagram-card">
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={ariaLabel}
    class="group block"
  >
    <MediaPlaceholder
      label={`Publicação ${index + 1} — a substituir`}
      aspectRatio="1/1"
      targetPath={post.targetPath}
      radiusClass="rounded-image-sm transition-transform duration-[var(--dur-hover)] ease-[var(--ease-standard)] group-hover:scale-[1.02]"
      watermarkOpacity={0.12}
      watermarkPosition="center"
    />
    <p aria-hidden="true" class="mt-3 line-clamp-2 font-body text-small text-muted">
      {post.caption}
    </p>
  </a>
</li>

<style>
  .instagram-card {
    width: 78%;
  }

  @media (min-width: 431px) {
    .instagram-card {
      width: 68%;
    }
  }

  @media (min-width: 768px) {
    .instagram-card {
      width: 44%;
    }
  }

  @media (min-width: 1024px) {
    .instagram-card {
      width: 31%;
    }
  }

  @media (min-width: 1280px) {
    .instagram-card {
      width: 24%;
    }
  }

  @media (min-width: 1440px) {
    .instagram-card {
      width: 22%;
      max-width: 280px;
    }
  }
</style>
