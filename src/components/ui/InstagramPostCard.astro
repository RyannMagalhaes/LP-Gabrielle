---
import { Image } from 'astro:assets';
import { buildInstagramProfileUrl, INSTAGRAM_HANDLE } from '@/lib/instagram.config';
import type { InstagramPost } from '@/data/instagram-posts';

interface Props {
  post: InstagramPost;
  index: number;
  total: number;
}

const { post, index, total } = Astro.props;
const title = `Publicação ${index + 1} de ${total} de Gabrielle Favere no Instagram: "${post.caption}"`;
---

<li class="flex-none snap-start instagram-card">
  {
    post.postUrl ? (
      <div class="instagram-embed overflow-hidden rounded-image-sm bg-surface-soft">
        <iframe
          src={`${post.postUrl}embed/`}
          title={title}
          loading="lazy"
          scrolling="no"
          allowtransparency="true"
          class="block w-full border-0"
        />
      </div>
    ) : (
      // Fallback until Gabrielle supplies this post's permalink - never
      // fabricate one, the embed needs the real /p/{id}/ URL.
      <a
        href={buildInstagramProfileUrl()}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${title}. Abrir perfil @${INSTAGRAM_HANDLE} no Instagram, nova aba.`}
        class="group block"
      >
        <Image
          src={post.image}
          alt={post.caption}
          width={560}
          loading="lazy"
          decoding="async"
          class="aspect-square w-full rounded-image-sm object-cover transition-transform duration-[var(--dur-hover)] ease-[var(--ease-standard)] group-hover:scale-[1.02]"
        />
        <p aria-hidden="true" class="mt-3 line-clamp-2 font-body text-small text-muted">
          {post.caption}
        </p>
      </a>
    )
  }
</li>

<style>
  .instagram-card {
    width: 78%;
  }

  @media (min-width: 431px) {
    .instagram-card {
      width: 68%;
    }
  }

  @media (min-width: 768px) {
    .instagram-card {
      width: 44%;
    }
  }

  @media (min-width: 1024px) {
    .instagram-card {
      width: 31%;
    }
  }

  @media (min-width: 1280px) {
    .instagram-card {
      width: 24%;
    }
  }

  @media (min-width: 1440px) {
    .instagram-card {
      width: 22%;
      max-width: 280px;
    }
  }

  .instagram-embed iframe {
    height: 631px;
  }
</style>
