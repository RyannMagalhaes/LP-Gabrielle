---
import { buildWhatsAppUrl, type WhatsAppContext } from '@/lib/whatsapp.config';

interface Props {
  context: WhatsAppContext;
  label?: string;
  variant?: 'solid' | 'outline';
  class?: string;
}

const {
  context,
  label = 'Quero conversar',
  variant = 'solid',
  class: className = '',
} = Astro.props;

const href = buildWhatsAppUrl(context);

const variantClass =
  variant === 'solid'
    ? 'bg-rose-deep text-white hover:bg-ink'
    : 'border border-ink/20 text-ink hover:border-rose-deep hover:text-rose-deep';
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-button px-7 py-3.5',
    'font-display text-body font-medium transition-colors duration-[var(--dur-hover)] ease-[var(--ease-standard)]',
    variantClass,
    className,
  ]}
>
  {label}
</a>
