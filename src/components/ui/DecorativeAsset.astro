---
// Reusable wrapper around Gabrielle's official photographic decorative marks
// (butterfly, bird, tulip cutouts - see Assets/Elementos_Estilo_Fotográfico).
// Purely ornamental: always alt="" and out of the tab/AT order, like
// OrganicShape.astro's treatment of the vector brand marks.
import { Image } from 'astro:assets';
import butterfly from '@/assets/decorative/butterfly.png';
import bird from '@/assets/decorative/bird.png';
import tulipClosedSalmon from '@/assets/decorative/tulip-closed-salmon.png';
import tulipClosedGreen from '@/assets/decorative/tulip-closed-green.png';
import tulipClosedBeige from '@/assets/decorative/tulip-closed-beige.png';
import tulipOpenSalmon from '@/assets/decorative/tulip-open-salmon.png';
import tulipOpenGreen from '@/assets/decorative/tulip-open-green.png';
import tulipOpenBeige from '@/assets/decorative/tulip-open-beige.png';

const ASSETS = {
  butterfly,
  bird,
  'tulip-closed-salmon': tulipClosedSalmon,
  'tulip-closed-green': tulipClosedGreen,
  'tulip-closed-beige': tulipClosedBeige,
  'tulip-open-salmon': tulipOpenSalmon,
  'tulip-open-green': tulipOpenGreen,
  'tulip-open-beige': tulipOpenBeige,
} as const;

interface Props {
  variant: keyof typeof ASSETS;
  widthPx: number;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { variant, widthPx, class: className = '', loading = 'lazy' } = Astro.props;
---

<Image
  src={ASSETS[variant]}
  alt=""
  aria-hidden="true"
  role="presentation"
  width={widthPx}
  loading={loading}
  decoding="async"
  class:list={['pointer-events-none select-none', className]}
/>
