---
import Container from '@/components/ui/Container.astro';
import Logo from '@/components/ui/Logo.astro';
import DecorativeAsset from '@/components/ui/DecorativeAsset.astro';
import { NAV_LINKS } from '@/data/nav-links';
import { buildWhatsAppUrl } from '@/lib/whatsapp.config';
import { buildInstagramProfileUrl } from '@/lib/instagram.config';

const whatsappHref = buildWhatsAppUrl('header');
const instagramHref = buildInstagramProfileUrl();
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-border bg-canvas py-16">
  <!-- Closing bookend: a single quiet tulip, echoing the hero's opening
       brand-mark accent - base flush with the footer's own bottom edge so
       it reads as rooted there, not floating past the corner. Shifted clear
       of the fixed floating WhatsApp button parked in that same corner. -->
  <div
    class="pointer-events-none absolute bottom-0 right-20 hidden w-[170px] opacity-80 md:block lg:right-24 lg:w-[200px]"
    aria-hidden="true"
  >
    <DecorativeAsset variant="tulip-closed-beige" widthPx={380} class="h-auto w-full rotate-[10deg]" />
  </div>

  <Container class="relative">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <Logo variant="full" widthPx={84} />
        <p class="mt-4 font-display text-h3 text-ink">Gabrielle Favere</p>
        <p class="font-body text-body text-muted">Psicóloga • CRP 04/87688</p>
      </div>

      <nav aria-label="Navegação do rodapé" class="flex flex-col gap-2">
        {
          NAV_LINKS.map((link) => (
            <a href={link.href} class="font-body text-body text-muted transition-colors hover:text-rose-deep">
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex flex-col gap-2">
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="font-body text-body text-muted transition-colors hover:text-rose-deep"
        >
          WhatsApp
        </a>
        <a
          href={instagramHref}
          target="_blank"
          rel="noopener noreferrer"
          class="font-body text-body text-muted transition-colors hover:text-rose-deep"
        >
          Instagram
        </a>
      </div>
    </div>

    <p class="mt-12 font-body text-small text-muted">
      &copy; {year} Gabrielle Favere. Todos os direitos reservados.
    </p>
  </Container>
</footer>
